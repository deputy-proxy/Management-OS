APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Keep debug output disabled by default; opt in only in a local development environment.
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# Java runtime used for the pinned XSLT 2.0 CIUS-RO validator.
EFACTURA_JAVA_BINARY=java

# ANAF e-Factura OAuth secrets must be set in the deployment secret manager, not committed.
EFACTURA_OAUTH_TOKEN_URL=https://logincert.anaf.ro/anaf-oauth2/v1/token
EFACTURA_TIMEOUT_SECONDS=30
EFACTURA_CONNECT_TIMEOUT_SECONDS=5
EFACTURA_TEST_CLIENT_ID=
EFACTURA_TEST_CLIENT_SECRET=
EFACTURA_TEST_REFRESH_TOKEN=
EFACTURA_TEST_UPLOAD_URL=https://api.anaf.ro/test/FCTEL/rest/upload
EFACTURA_TEST_STATUS_URL=https://api.anaf.ro/test/FCTEL/rest/stareMesaj
EFACTURA_TEST_DOWNLOAD_URL=https://api.anaf.ro/test/FCTEL/rest/descarcare
EFACTURA_PRODUCTION_CLIENT_ID=
EFACTURA_PRODUCTION_CLIENT_SECRET=
EFACTURA_PRODUCTION_REFRESH_TOKEN=
EFACTURA_PRODUCTION_UPLOAD_URL=https://api.anaf.ro/prod/FCTEL/rest/upload
EFACTURA_PRODUCTION_STATUS_URL=https://api.anaf.ro/prod/FCTEL/rest/stareMesaj
EFACTURA_PRODUCTION_DOWNLOAD_URL=https://api.anaf.ro/prod/FCTEL/rest/descarcare

# Google Ads API v26. Configure secrets in the deployment secret manager.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_TIMEOUT=30
GOOGLE_ADS_MAX_RANGE_DAYS=90

# Google Ads scheduled refresh remains disabled until account access is approved.
GOOGLE_ADS_SCHEDULED_REFRESH_ENABLED=false
GOOGLE_ADS_STALE_AFTER_HOURS=36
GOOGLE_ADS_RETRY_BASE_DELAY_MINUTES=5
